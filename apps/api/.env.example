# Hex Payroll API — environment template.
# Copy to `.env` in this same directory (apps/api/.env) and fill in real values.
# `.env` is gitignored; this template is committed.

NODE_ENV=development

# Loopback only. The desktop's private API must not be reachable from the network.
API_HOST=127.0.0.1
API_PORT=4311

LOG_LEVEL=info

# Transport is opt-in. Central: SYNC_MODE=central. Desktop: enroll first, then local.
SYNC_MODE=disabled
SYNC_INTERVAL_MS=15000
# SYNC_CENTRAL_URL=https://payroll.example.com
# SYNC_NODE_ID=installation-uuid
# SYNC_NODE_TOKEN=secret-returned-once-at-registration

# Runtime role: SELECT/INSERT/UPDATE/DELETE only. Has NO right to alter schema.
DATABASE_URL=postgresql://hexpayroll_app:CHANGE_ME@127.0.0.1:5432/hexpayroll_dev

# Migration role: owns the schema. Used ONLY by the migration runner (Phase 1),
# never by the running API process.
MIGRATION_DATABASE_URL=postgresql://hexpayroll_migrator:CHANGE_ME@127.0.0.1:5432/hexpayroll_dev
