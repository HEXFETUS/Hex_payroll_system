{
  "name": "@hexpayroll/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hex Payroll HTTP API. Built as a single deployable so it can run both as the desktop's private local server and as the central server.",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hexpayroll/payroll-engine": "workspace:*",
    "@hexpayroll/shared": "workspace:*",
    "dotenv": "18.0.4",
    "express": "5.2.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
