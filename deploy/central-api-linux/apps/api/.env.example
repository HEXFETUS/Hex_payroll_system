# Create apps/api/.env on the VPS only. Never copy a desktop .env here.
NODE_ENV=production
API_HOST=127.0.0.1
API_PORT=4311
LOG_LEVEL=info
SYNC_MODE=central

# Replace CHANGE_ME with the VPS runtime-role password; URL-encode special characters.
DATABASE_URL=postgresql://hexpayroll_app:CHANGE_ME@127.0.0.1:5433/payroll_central

# The runtime service does not need migration credentials or desktop node tokens.
