{
  "name": "@hexpayroll/payroll-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure, dependency-light payroll computation core. Runs identically on the desktop and on the central server. No I/O, no database access.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hexpayroll/shared": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
