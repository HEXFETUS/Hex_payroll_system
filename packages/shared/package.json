{
  "name": "@hexpayroll/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared contracts, validation primitives and money helpers used by the API, the web app and the desktop shell.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
